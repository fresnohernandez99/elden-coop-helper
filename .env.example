# MongoDB Atlas connection string. Only teams are stored there (name, hashed
# password, members and the last saved snapshot of each player).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Optional database name (default: eldencoop).
# MONGODB_DB=

# Signs the session cookies (at least 16 characters). Changing it logs everyone out.
SESSION_SECRET=

# Optional tile URL template; {map} is replaced by the map folder.
# Defaults to /tiles/{map}/{z}_{x}_{y}.jpg (proxied to Game8 and cached by the browser).
# After scripts/download_tiles.py use: /map-tiles/{map}/{z}_{x}_{y}.jpg
# TILE_URL=

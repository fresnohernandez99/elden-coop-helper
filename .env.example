# Each player logs in on the home page with their password and any character name.
# Up to 6 player slots; only the slots with a password exist. Use long, different passwords.
PLAYER1_PASSWORD=change-me-player-1
PLAYER2_PASSWORD=change-me-player-2
# PLAYER3_PASSWORD=
# PLAYER4_PASSWORD=
# PLAYER5_PASSWORD=
# PLAYER6_PASSWORD=

# Optional extra secret for signing session cookies. Changing it logs everyone out.
SESSION_SECRET=

# Optional tile URL template; {map} is replaced by the map folder.
# Defaults to /tiles/{map}/{z}_{x}_{y}.jpg (proxied to Game8 and cached by the browser).
# After scripts/download_tiles.py use: /map-tiles/{map}/{z}_{x}_{y}.jpg
# TILE_URL=
